# Required: your iCloud login.
# Generate an app-specific password at:
#   https://account.apple.com → Sign-In and Security → App-Specific Passwords
ICLOUD_EMAIL=yourname@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: Mail / Calendar / Contacts endpoints. Defaults below match iCloud.
# Override only if you're proxying or testing against a different DAV server.
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
# CALDAV_URL=https://caldav.icloud.com    # Calendar + Reminders (VTODO)
# CARDDAV_URL=https://contacts.icloud.com # Contacts

# Optional: default IANA timezone for date/time outputs when a tool doesn't
# specify one. Falls back to system timezone if unset.
# DEFAULT_TIMEZONE=Australia/Melbourne

# Legacy static bearer token. Still accepted by /api/mcp for stdio callers and
# the Claude *API* (mcp_servers authorization_token). The Claude *app* connector
# uses OAuth instead (see the OAUTH block below). Leave unset if you only use the
# OAuth connector.
AUTH_TOKEN=some-random-secret-token

# ── OAuth for the Claude app connector (Better Auth) ────────────────────────
# The Claude app requires connectors to use OAuth, not a static token. These
# power src/auth.ts, which makes this deployment an OAuth provider. The OAuth
# layer only verifies it's *you*; your iCloud creds above never pass through it.
#
# Full origin of your deployment (no trailing slash).
BETTER_AUTH_URL=https://your-deployment.vercel.app
# 32+ random bytes. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-32-plus-byte-hex-secret-here
# Neon Postgres connection string (use the pooled "-pooler" host). Free tier.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# GitHub OAuth app (Settings → Developer settings → OAuth Apps). Set its
# "Authorization callback URL" to: https://your-deployment.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Single-user gate: comma-separated allowlist of GitHub account emails permitted
# to sign in. Only these can create an account; everyone else is refused.
ALLOWED_EMAILS=you@example.com

# Required for v4.2 triage verb. Signs the confirmToken so triage_commit can
# verify the user's confirmation matches the original proposal. Must be 32+
# random bytes (recommend hex-encoded; produce with: openssl rand -hex 32).
# Separate from AUTH_TOKEN so a leaked bearer token can't be used to forge
# triage proposals.
CONFIRM_TOKEN_SECRET=your-32-plus-byte-hex-secret-here
